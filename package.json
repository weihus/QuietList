{
  "name": "quietlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit --strict --skipLibCheck --target ES2022 --moduleResolution bundler --module esnext --lib ES2022,DOM,DOM.Iterable functions/api/sync.ts && vite build",
